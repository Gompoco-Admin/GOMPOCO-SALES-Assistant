{
  "entities": {
    "StaffMember": {
      "title": "StaffMember",
      "description": "Internal Gompoco salesperson or administrator profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "salesperson"]
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "active", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted registry document elevating a staff user to administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Gompoco business and EFT payment configuration for quotations and invoices.",
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slogan": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "vatNumber": {
          "type": "string",
          "maxLength": 40
        },
        "bankName": {
          "type": "string",
          "maxLength": 100
        },
        "accountHolder": {
          "type": "string",
          "maxLength": 120
        },
        "accountNumber": {
          "type": "string",
          "maxLength": 40
        },
        "branchCode": {
          "type": "string",
          "maxLength": 30
        },
        "paymentTerms": {
          "type": "string",
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "businessName",
        "slogan",
        "phone",
        "email",
        "address",
        "vatNumber",
        "bankName",
        "accountHolder",
        "accountNumber",
        "branchCode",
        "paymentTerms",
        "updatedBy",
        "updatedAt"
      ]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Customer profile, enquiry metadata, pest discovery, and assessment booking.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "phoneRaw": {
          "type": "string",
          "minLength": 9,
          "maxLength": 30
        },
        "phoneNormalized": {
          "type": "string",
          "minLength": 11,
          "maxLength": 15,
          "pattern": "^27[1-9][0-9]{8}$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "propertyAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "suburb": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Residential", "Commercial", "Industrial"]
        },
        "preferredContactMethod": {
          "type": "string",
          "enum": ["WhatsApp", "Phone Call", "Email"]
        },
        "enquiryDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "salespersonName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "discovery": {
          "type": "object"
        },
        "booking": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "fullName",
        "phoneRaw",
        "phoneNormalized",
        "email",
        "propertyAddress",
        "suburb",
        "category",
        "preferredContactMethod",
        "enquiryDate",
        "salespersonName",
        "notes",
        "discovery",
        "booking",
        "createdAt",
        "updatedAt"
      ]
    },
