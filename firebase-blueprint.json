  "firestore": {
    "/staff/{uid}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Internal Gompoco staff profiles and active flags."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Administrator role grants managed by existing admins."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Company contact and EFT billing settings."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Customer profiles, discovery responses, and assessment bookings."
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/AssessmentRecord" },
      "description": "Assessment findings and treatment recommendation records."
    },
    "/assessments/{assessmentId}/attachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/AssessmentAttachment" },
      "description": "Supporting compressed photo attachments for assessments."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/QuotationRecord" },
      "description": "Quotations linked to customers and assessments."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/InvoiceRecord" },
      "description": "Invoices generated from approved quotations."
    },
    "/whatsappLogs/{logId}": {
      "schema": { "$ref": "#/entities/WhatsAppLog" },
      "description": "Manually confirmed WhatsApp communication logs."
    }
  }
}
